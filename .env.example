# --- Firebase (new project for Teein' It Up) ---
# Service-account JSON on one line: Firebase console → Project settings →
# Service accounts → Generate new private key. Stores members, hours, waivers.
FIREBASE_SERVICE_ACCOUNT=
# Web app config JSON on one line: Project settings → General → Your apps.
# Enables member login (enable Email/Password under Authentication).
FIREBASE_WEB_CONFIG=

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Preview only: email-only login and local file storage. Never set in production.
DEV_AUTH=

# TrackMan API (once access is granted) — switches stats from sample to real data.
TRACKMAN_CLIENT_ID=
TRACKMAN_CLIENT_SECRET=
